# AWS-targeted image: bakes the daily_dumps + shared CSVs in so the ECS task
# is fully self-contained (no S3 source bucket, no host volume to mount).
#
# Build from the G3_ETL/ root (one level above the pipeline/ directory):
#   docker build -f Dockerfile.aws -t nafad-g3-aws:v1 .

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DAILY_DUMPS_DIR=/data/daily_dumps \
    SHARED_DIR=/data/shared

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

COPY pipeline/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY pipeline/   /app/pipeline
COPY sql/        /app/sql
COPY tests/      /app/tests
COPY daily_dumps /data/daily_dumps
COPY shared      /data/shared

ENTRYPOINT ["python", "-m", "pipeline.main"]
CMD ["all"]
